# ========================================================
# VVK Portfolio — Backend Environment Variables
# Copy this file to .env inside backend/ directory (or set in Render)
# NEVER commit your actual .env file to GitHub
# ========================================================

# Flask secret key (generate a random secure string, or let Render generate it)
SECRET_KEY=dev-secret-key-change-in-production

# CORS allowed frontend domains (comma-separated, or * for all)
ALLOWED_ORIGINS=https://vadrangi-vishal-kumar.vercel.app,http://localhost:5173

# Gmail SMTP Configuration
# Create a 16-character Google App Password:
# Enable 2FA on Gmail -> Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The email address that receives contact form messages
MAIL_RECIPIENT=vadrangi.vishalkumar@gmail.com

# Flask production settings
FLASK_ENV=production
PORT=5000
