# Copy this file to .env and fill in your values
# NEVER commit the actual .env to GitHub

# Flask secret key (generate a random string)
SECRET_KEY=your-random-secret-key-here

# Gmail SMTP — use an App Password (not your real Gmail password)
# Enable 2FA on Gmail → Google Account → Security → App Passwords
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The email address that receives contact form messages
MAIL_RECIPIENT=vadrangi.vishalkumar@gmail.com

# Flask environment
FLASK_ENV=production
PORT=5000
